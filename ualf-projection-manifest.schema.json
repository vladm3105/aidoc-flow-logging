{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iplanic.ai/schemas/ualf-projection-manifest.schema.json",
  "title": "UALF derived projection manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "projection_id", "source_profile", "target", "source", "outputs", "exporter", "record_mappings", "omissions", "loss_class", "privacy", "validator", "generated_at"],
  "properties": {
    "profile": { "const": "ualf-projection-manifest/v1" },
    "projection_id": { "$ref": "#/$defs/id" },
    "source_profile": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "specification", "revision"],
      "properties": {
        "profile": { "enum": ["ualf-otel-genai/v1", "ualf-openinference/v1", "ualf-openlineage/v1", "ualf-croissant/v1", "ualf-in-toto-qualification/v1", "ualf-analytics/v1", "ualf-sft/v1", "ualf-preference/v1", "ualf-rl/v1", "ualf-benchmark/v1"] },
        "specification": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "source": { "$ref": "#/$defs/artifact" },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "exporter": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "source_revision", "deterministic"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 1 },
        "deterministic": { "type": "boolean" }
      }
    },
    "record_mappings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "targets"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "id_derivation": { "type": "string" }
        }
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_semantic", "reason", "effect"],
        "properties": {
          "source_semantic": { "type": "string", "minLength": 1 },
          "reason": { "enum": ["unsupported", "privacy", "policy", "redundant", "not_applicable"] },
          "effect": { "enum": ["none", "metadata_loss", "content_loss", "causality_loss", "replay_loss", "rights_loss"] },
          "details": { "type": "string" }
        }
      }
    },
    "loss_class": { "enum": ["lossless", "semantically_lossy", "content_filtered", "aggregate_only"] },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "raw_content", "transformation"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "raw_content": { "enum": ["included", "excluded", "selective"] },
        "transformation": { "enum": ["none", "hash", "pseudonymize", "redact", "aggregate", "mixed"] }
      }
    },
    "validator": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "result", "validated_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "result": { "enum": ["passed", "failed", "not_available"] },
        "validated_at": { "type": "string", "format": "date-time" },
        "report": { "$ref": "#/$defs/artifact" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[a-z0-9.-]+/.+$" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "media_type"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$" }
      }
    }
  }
}
