{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iplanic.ai/schemas/ualf-dataset-manifest.schema.json",
  "title": "UALF Dataset Manifest (ualf-dataset/v1.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dataset_id", "created_at", "trace_schema", "export_profile", "intended_uses", "prohibited_uses", "traces", "blobs", "splits", "rights_summary", "deduplication", "quality_report", "datasheet", "provenance", "seal"],
  "properties": {
    "schema": { "const": "ualf-dataset/v1.1" },
    "dataset_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "trace_schema": { "const": "ualf-trace/v1" },
    "export_profile": { "enum": ["full", "model-text-filtered", "metadata-only"] },
    "intended_uses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "prohibited_uses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trajectory_id", "path", "sha256", "bytes"],
        "properties": {
          "trajectory_id": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/jsonlPath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "blobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "$ref": "#/$defs/safePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "validation": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "test": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "rights_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owners", "license", "reviewed_by", "reviewed_at", "evidence"],
      "properties": {
        "status": { "enum": ["cleared", "restricted", "unresolved"] },
        "owners": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "license": { "type": "string", "minLength": 1 },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "deduplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "exact_duplicates_remaining", "report"],
      "properties": {
        "method": { "const": "exact-sha256/v1" },
        "exact_duplicates_remaining": { "const": 0 },
        "report": { "$ref": "#/$defs/artifact" }
      }
    },
    "quality_report": { "$ref": "#/$defs/artifact" },
    "datasheet": { "$ref": "#/$defs/artifact" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signing"],
      "properties": { "signing": { "$ref": "#/$defs/signing" } }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "signature"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key_id", "algorithm", "value"],
          "properties": {
            "key_id": { "$ref": "#/$defs/id" },
            "algorithm": { "const": "ed25519" },
            "value": { "type": "string", "minLength": 88, "maxLength": 88 }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safePath": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "jsonlPath": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.jsonl$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key"],
      "properties": {
        "key_id": { "$ref": "#/$defs/id" },
        "algorithm": { "const": "ed25519" },
        "public_key": { "type": "string", "minLength": 44, "maxLength": 44 }
      }
    }
  }
}
