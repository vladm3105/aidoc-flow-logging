{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iplanic.ai/schemas/ualf/dataset/v1.2/manifest.schema.json",
  "title": "UALF Dataset Manifest (ualf-dataset/v1.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dataset_id", "created_at", "trace_schema", "export_profile", "intended_uses", "prohibited_uses", "traces", "blobs", "splits", "rights_summary", "deduplication", "quality_report", "datasheet", "machine_datasheet", "provenance", "seal"],
  "properties": {
    "schema": { "const": "ualf-dataset/v1.2" },
    "dataset_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "trace_schema": { "const": "ualf-trace/v1.1" },
    "export_profile": { "enum": ["full", "model-text-filtered", "metadata-only"] },
    "intended_uses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "prohibited_uses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trajectory_id", "path", "sha256", "bytes", "capture", "amendments", "retention", "revocation", "hygiene_evidence", "replay_evidence", "external_dependencies"],
        "properties": {
          "trajectory_id": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/jsonlPath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 1 },
          "capture": {
            "oneOf": [
              { "$ref": "#/$defs/artifact" },
              {
                "type": "object", "additionalProperties": false,
                "required": ["mode", "generator", "reason"],
                "properties": {
                  "mode": { "const": "synthetic" },
                  "generator": { "type": "string", "minLength": 1 },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "amendments": {
            "type": "object", "additionalProperties": false,
            "required": ["state", "as_of", "count"],
            "properties": {
              "state": { "enum": ["none", "present"] },
              "as_of": { "type": "string", "format": "date-time" },
              "count": { "type": "integer", "minimum": 0 },
              "stream": { "$ref": "#/$defs/artifact" },
              "terminal_sha256": { "$ref": "#/$defs/sha256" }
            },
            "allOf": [
              { "if": { "properties": { "state": { "const": "none" } }, "required": ["state"] }, "then": { "properties": { "count": { "const": 0 } }, "not": { "anyOf": [ { "required": ["stream"] }, { "required": ["terminal_sha256"] } ] } } },
              { "if": { "properties": { "state": { "const": "present" } }, "required": ["state"] }, "then": { "required": ["stream", "terminal_sha256"], "properties": { "count": { "minimum": 1 } } } }
            ]
          },
          "retention": {
            "oneOf": [
              { "$ref": "#/$defs/artifact" },
              {
                "type": "object", "additionalProperties": false,
                "required": ["mode", "retention_class", "expires_at", "erasure_method"],
                "properties": {
                  "mode": { "const": "package" },
                  "retention_class": { "type": "string", "minLength": 1 },
                  "expires_at": { "type": ["string", "null"], "format": "date-time" },
                  "erasure_method": { "enum": ["delete", "cryptographic_shred", "anonymize", "retain"] }
                }
              }
            ]
          },
          "revocation": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "checked_at", "authority"],
            "properties": {
              "status": { "enum": ["active", "revoked", "erased"] },
              "checked_at": { "type": "string", "format": "date-time" },
              "authority": { "type": "string", "minLength": 1 },
              "evidence": { "$ref": "#/$defs/artifact" }
            }
          },
          "hygiene_evidence": { "$ref": "#/$defs/artifact" },
          "replay_evidence": { "$ref": "#/$defs/artifact" },
          "external_dependencies": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["artifact", "available_until", "failure_behavior"],
              "properties": {
                "artifact": { "$ref": "#/$defs/artifact" },
                "available_until": { "type": "string", "format": "date-time" },
                "failure_behavior": { "enum": ["reject_package", "mark_unavailable"] }
              }
            }
          }
        }
      }
    },
    "blobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "$ref": "#/$defs/safePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "validation": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "test": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "rights_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owners", "license", "reviewed_by", "reviewed_at", "evidence"],
      "properties": {
        "status": { "enum": ["cleared", "restricted", "unresolved"] },
        "owners": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "license": { "type": "string", "minLength": 1 },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "deduplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "exact_duplicates_remaining", "near_duplicate_method", "near_duplicates_reviewed", "benchmark_contamination", "split_leakage", "report"],
      "properties": {
        "method": { "const": "exact-sha256/v1" },
        "exact_duplicates_remaining": { "const": 0 },
        "near_duplicate_method": { "type": "string", "minLength": 1 },
        "near_duplicates_reviewed": { "type": "integer", "minimum": 0 },
        "benchmark_contamination": { "enum": ["none_detected", "findings_resolved", "findings", "not_run"] },
        "split_leakage": { "enum": ["none_detected", "findings_resolved", "findings", "not_run"] },
        "report": { "$ref": "#/$defs/artifact" }
      }
    },
    "quality_report": { "$ref": "#/$defs/artifact" },
    "datasheet": { "$ref": "#/$defs/artifact" },
    "machine_datasheet": { "$ref": "#/$defs/artifact" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signing"],
      "properties": { "signing": { "$ref": "#/$defs/signing" } }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "signature"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key_id", "algorithm", "value"],
          "properties": {
            "key_id": { "$ref": "#/$defs/id" },
            "algorithm": { "const": "ed25519" },
            "value": { "type": "string", "minLength": 88, "maxLength": 88 }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safePath": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "jsonlPath": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.jsonl$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key"],
      "properties": {
        "key_id": { "$ref": "#/$defs/id" },
        "algorithm": { "const": "ed25519" },
        "public_key": { "type": "string", "minLength": 44, "maxLength": 44 }
      }
    }
  }
}
