# Workspace .gitignore baseline per docs/REPO_STANDARDS.md §10.1.
#
# Repo-specific ignores EXTEND this baseline (do not replace it).
# When applying via apply-standards.sh, the target's existing
# .gitignore is preserved and this baseline is merged in
# (deduplicated, sorted per section).

# AI-workspace scratch
.claude/
.review/

# Transient
tmp/
scratch/
.ualf/

# Env / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
dist/
build/
*.egg-info/

# Node
node_modules/
.npm-cache/

# OS / editors
.DS_Store
.vscode/
.idea/
Thumbs.db
uv.lock

# >>> aidoc-local-flow-ci >>>
.ci-out/
.task/
.env
test-results/
coverage.xml
.coverage
coverage.out
lcov.info
coverage/
.lycheecache
# Canon files whose names match common secret patterns (e.g. *secret*): never ignored.
!.ci/bin/secrets
!scripts/secret_scan.py
# <<< aidoc-local-flow-ci <<<
