{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iplanic.ai/schemas/ualf/retention/v1.1/record.schema.json",
  "title": "UALF retention and erasure policy binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "organization", "project", "environment", "subject", "policy_id", "retention_class", "created_at", "legal_hold", "artifact_policy", "erasure", "seal"],
  "properties": {
    "profile": { "const": "ualf-retention/v1.1" },
    "organization": { "type": "string", "minLength": 3 },
    "project": { "type": "string", "minLength": 3 },
    "environment": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "sha256"],
      "properties": {
        "kind": { "enum": ["trace", "dataset", "blob", "projection"] },
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy_id": { "type": "string", "minLength": 3 },
    "retention_class": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "legal_hold": {
      "type": "object", "additionalProperties": false,
      "required": ["active"],
      "properties": { "active": { "type": "boolean" }, "authority": { "type": "string" }, "reason": { "type": "string" }, "review_at": { "type": "string", "format": "date-time" } }
    },
    "artifact_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["dependency_mode", "dangling_reference_behavior"],
      "properties": {
        "dependency_mode": { "enum": ["self_contained", "external_pinned", "mixed"] },
        "availability_commitment_until": { "type": "string", "format": "date-time" },
        "dangling_reference_behavior": { "enum": ["reject_package", "mark_unavailable", "retain_tombstone"] }
      }
    },
    "encryption": {
      "type": "object", "additionalProperties": false,
      "required": ["at_rest", "key_id"],
      "properties": { "at_rest": { "type": "boolean" }, "algorithm": { "type": "string" }, "key_id": { "type": "string", "minLength": 1 }, "key_registry": { "type": "string", "format": "uri" } }
    },
    "erasure": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "statement_required"],
      "properties": {
        "method": { "enum": ["delete", "cryptographic_shred", "anonymize", "retain"] },
        "statement_required": { "type": "boolean" },
        "statement_schema": { "type": "string", "format": "uri" }
      }
    },
    "seal": { "$ref": "#/$defs/seal" },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[a-z0-9.-]+/.+$" } }
  },
  "allOf": [
    { "if": { "properties": { "legal_hold": { "properties": { "active": { "const": true } }, "required": ["active"] } } }, "then": { "properties": { "legal_hold": { "required": ["authority", "reason", "review_at"] } } } },
    { "if": { "properties": { "artifact_policy": { "properties": { "dependency_mode": { "enum": ["external_pinned", "mixed"] } }, "required": ["dependency_mode"] } } }, "then": { "properties": { "artifact_policy": { "required": ["availability_commitment_until"] } } } }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "seal": { "type": "object", "additionalProperties": false, "required": ["key_id", "algorithm", "public_key", "document_sha256", "signature"], "properties": { "key_id": { "type": "string", "minLength": 3 }, "algorithm": { "const": "ed25519" }, "public_key": { "type": "string", "minLength": 44, "maxLength": 44 }, "document_sha256": { "$ref": "#/$defs/sha256" }, "signature": { "type": "string", "minLength": 88, "maxLength": 88 } } }
  }
}
