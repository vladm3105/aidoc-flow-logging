{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iplanic.ai/schemas/ualf-trajectory.schema.json",
  "title": "UALF Trace Line (ualf-trace/v1)",
  "oneOf": [
    { "$ref": "#/$defs/header" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/outcome" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9.-]+/.+$" }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source"],
      "properties": {
        "type": { "enum": ["project", "human", "model", "tool", "third_party", "external_system"] },
        "source": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "blobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref", "bytes", "media_type", "encoding", "content_role", "origin"],
      "properties": {
        "$ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$" },
        "encoding": { "enum": ["identity", "gzip"] },
        "content_role": {
          "enum": ["authored_prompt", "model_input", "model_output", "model_reasoning", "tool_output", "observation", "diff", "evidence", "initial_state", "tool_definitions", "artifact", "human_content"]
        },
        "origin": { "$ref": "#/$defs/origin" }
      },
      "allOf": [
        {
          "if": { "properties": { "content_role": { "enum": ["model_output", "model_reasoning"] } }, "required": ["content_role"] },
          "then": { "properties": { "origin": { "properties": { "type": { "const": "model" } }, "required": ["type", "source"] } } }
        }
      ]
    },
    "inlineContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "origin"],
      "properties": {
        "value": true,
        "origin": { "$ref": "#/$defs/origin" }
      }
    },
    "goalRef": {
      "allOf": [
        { "$ref": "#/$defs/blobRef" },
        { "properties": { "content_role": { "enum": ["authored_prompt", "human_content"] } } }
      ]
    },
    "toolsRef": {
      "allOf": [
        { "$ref": "#/$defs/blobRef" },
        { "properties": { "content_role": { "const": "tool_definitions" } } }
      ]
    },
    "initialStateRef": {
      "allOf": [
        { "$ref": "#/$defs/blobRef" },
        { "properties": { "content_role": { "const": "initial_state" } } }
      ]
    },
    "modelContextRef": {
      "allOf": [
        { "$ref": "#/$defs/blobRef" },
        { "properties": { "content_role": { "enum": ["authored_prompt", "model_input", "model_output", "tool_output", "observation", "human_content"] } } }
      ]
    },
    "modelOutputRef": {
      "allOf": [
        { "$ref": "#/$defs/blobRef" },
        {
          "properties": {
            "content_role": { "const": "model_output" },
            "origin": { "properties": { "type": { "const": "model" } } }
          }
        }
      ]
    },
    "modelReasoningRef": {
      "allOf": [
        { "$ref": "#/$defs/blobRef" },
        {
          "properties": {
            "content_role": { "const": "model_reasoning" },
            "origin": { "properties": { "type": { "const": "model" } } }
          }
        }
      ]
    },
    "toolOutputRef": {
      "allOf": [
        { "$ref": "#/$defs/blobRef" },
        { "properties": { "content_role": { "const": "tool_output" } } }
      ]
    },
    "observationRef": {
      "allOf": [
        { "$ref": "#/$defs/blobRef" },
        { "properties": { "content_role": { "const": "observation" } } }
      ]
    },
    "diffRef": {
      "allOf": [
        { "$ref": "#/$defs/blobRef" },
        { "properties": { "content_role": { "const": "diff" } } }
      ]
    },
    "evidenceRef": {
      "allOf": [
        { "$ref": "#/$defs/blobRef" },
        { "properties": { "content_role": { "const": "evidence" } } }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["agent", "human", "system", "tool", "evaluator"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key"],
      "properties": {
        "key_id": { "$ref": "#/$defs/id" },
        "algorithm": { "const": "ed25519" },
        "public_key": { "type": "string", "minLength": 44, "maxLength": 44 }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "seq", "schema", "run_id", "trace_id", "trajectory_id", "project", "domain", "agent", "task", "environment", "capture", "rights", "provenance", "started_at"],
      "properties": {
        "kind": { "const": "header" },
        "seq": { "const": 1 },
        "schema": { "const": "ualf-trace/v1" },
        "run_id": { "$ref": "#/$defs/id" },
        "trace_id": { "$ref": "#/$defs/id" },
        "trajectory_id": { "$ref": "#/$defs/id" },
        "project": { "type": "string", "pattern": "^proj-[a-z0-9-]{2,}$" },
        "domain": { "enum": ["software_dev", "trading", "smart_home", "ops", "research", "other"] },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["framework", "framework_version", "role", "agent_version", "prompt_version"],
          "properties": {
            "framework": { "type": "string", "minLength": 1 },
            "framework_version": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "agent_version": { "type": "string", "minLength": 1 },
            "prompt_version": { "type": "string", "minLength": 1 }
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal", "category", "acceptance"],
          "properties": {
            "goal": { "$ref": "#/$defs/goalRef" },
            "category": { "type": "string", "minLength": 1 },
            "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "work_order": { "$ref": "#/$defs/blobRef" },
            "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspace_sha256", "source_revision", "os", "runtime_versions", "tools_ref", "replay"],
          "properties": {
            "workspace_sha256": { "$ref": "#/$defs/sha256" },
            "source_revision": { "type": "string", "minLength": 1 },
            "image_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "os": { "type": "string", "minLength": 1 },
            "runtime_versions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
            "tools_ref": { "$ref": "#/$defs/toolsRef" },
            "replay": {
              "type": "object",
              "additionalProperties": false,
              "required": ["available_level", "model_responses_captured", "tool_responses_captured", "nondeterministic_inputs_captured"],
              "properties": {
                "available_level": { "enum": ["none", "trace", "stubbed", "tool_reexecution", "full_reexecution", "outcome_reproduced"] },
                "initial_state_ref": { "$ref": "#/$defs/initialStateRef" },
                "model_responses_captured": { "type": "boolean" },
                "tool_responses_captured": { "type": "boolean" },
                "nondeterministic_inputs_captured": { "type": "boolean" },
                "verification": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "verified_at", "result_match", "evidence_ref"],
                  "properties": {
                    "status": { "enum": ["passed", "failed"] },
                    "verified_at": { "type": "string", "format": "date-time" },
                    "result_match": { "type": "boolean" },
                    "evidence_ref": { "$ref": "#/$defs/evidenceRef" }
                  }
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "available_level": { "enum": ["stubbed", "tool_reexecution", "full_reexecution", "outcome_reproduced"] } } },
                  "then": {
                    "required": ["verification"],
                    "properties": {
                      "model_responses_captured": { "const": true },
                      "tool_responses_captured": { "const": true }
                    }
                  }
                },
                {
                  "if": { "properties": { "available_level": { "enum": ["tool_reexecution", "full_reexecution", "outcome_reproduced"] } } },
                  "then": {
                    "required": ["initial_state_ref"],
                    "properties": { "nondeterministic_inputs_captured": { "const": true } }
                  }
                }
              ]
            }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context_policy", "redaction_policy", "retention_mode"],
          "properties": {
            "context_policy": { "enum": ["complete", "metadata_only", "selective"] },
            "redaction_policy": { "type": "string", "minLength": 1 },
            "retention_mode": { "enum": ["full", "references", "metadata_only"] }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "classification", "model_sources", "pii", "secrets_scan"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "classification": { "enum": ["internal", "candidate", "cleared"] },
            "model_sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "pii": { "enum": ["none", "redacted", "present", "unknown"] },
            "secrets_scan": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tool", "version", "verdict"],
              "properties": {
                "tool": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "verdict": { "enum": ["clean", "findings", "not_run"] }
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signing"],
          "properties": { "signing": { "$ref": "#/$defs/signing" } }
        },
        "started_at": { "type": "string", "format": "date-time" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "contextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "role", "content_ref"],
      "properties": {
        "position": { "type": "integer", "minimum": 0 },
        "role": { "enum": ["system", "developer", "user", "assistant", "tool"] },
        "name": { "type": "string" },
        "tool_call_id": { "$ref": "#/$defs/id" },
        "content_ref": { "$ref": "#/$defs/modelContextRef" }
      }
    },
    "modelStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "provider", "model", "parameters", "context", "tools_ref", "context_complete"],
      "properties": {
        "call_id": { "$ref": "#/$defs/id" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" },
        "context": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contextItem" } },
        "tools_ref": { "$ref": "#/$defs/toolsRef" },
        "context_complete": { "type": "boolean" },
        "incomplete_reason": { "enum": ["policy", "redaction", "legacy", "capture_failure"] }
      },
      "if": { "properties": { "context_complete": { "const": false } } },
      "then": { "required": ["incomplete_reason"] },
      "else": { "not": { "required": ["incomplete_reason"] } }
    },
    "modelCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "provider", "model", "usage", "cost_usd", "latency_ms", "finish_reason"],
      "properties": {
        "call_id": { "$ref": "#/$defs/id" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens_in", "tokens_out"],
          "properties": {
            "tokens_in": { "type": "integer", "minimum": 0 },
            "tokens_out": { "type": "integer", "minimum": 0 }
          }
        },
        "cost_usd": { "type": "number", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "finish_reason": { "type": "string", "minLength": 1 },
        "output_ref": { "$ref": "#/$defs/modelOutputRef" },
        "no_output": { "const": true },
        "request_id": { "type": "string" }
      },
      "oneOf": [ { "required": ["output_ref"] }, { "required": ["no_output"] } ]
    },
    "toolStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "tool", "tool_version", "arguments"],
      "properties": {
        "call_id": { "$ref": "#/$defs/id" },
        "tool": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "string", "minLength": 1 },
        "arguments": { "$ref": "#/$defs/inlineContent" }
      }
    },
    "toolCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "tool", "status", "latency_ms"],
      "properties": {
        "call_id": { "$ref": "#/$defs/id" },
        "tool": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ok", "error", "cancelled"] },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "output": { "$ref": "#/$defs/inlineContent" },
        "output_ref": { "$ref": "#/$defs/toolOutputRef" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "message"],
          "properties": { "class": { "type": "string", "minLength": 1 }, "message": { "type": "string" } }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ok" } } },
          "then": {
            "anyOf": [ { "required": ["output"] }, { "required": ["output_ref"] } ],
            "not": { "required": ["error"] }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["error", "cancelled"] } } },
          "then": { "required": ["error"] }
        }
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator", "evaluator_version", "method", "status", "evidence_quality", "evidence_ref"],
      "properties": {
        "evaluator": { "type": "string", "minLength": 1 },
        "evaluator_version": { "type": "string", "minLength": 1 },
        "method": { "enum": ["oracle:test", "oracle:gate", "oracle:ci", "oracle:pnl", "oracle:policy", "human", "judge", "self_assessed"] },
        "status": { "enum": ["passed", "failed", "partial"] },
        "score": { "type": ["number", "null"] },
        "evidence_quality": { "enum": ["self_report", "artifact", "signed_external", "reproduced"] },
        "evidence_ref": { "$ref": "#/$defs/evidenceRef" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "seq", "event_id", "run_id", "trace_id", "span_id", "actor", "timestamp", "monotonic_ms", "type", "data", "prev_sha256"],
      "properties": {
        "kind": { "const": "event" },
        "seq": { "type": "integer", "minimum": 2 },
        "event_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "trace_id": { "$ref": "#/$defs/id" },
        "span_id": { "$ref": "#/$defs/id" },
        "parent_span_id": { "oneOf": [ { "$ref": "#/$defs/id" }, { "type": "null" } ] },
        "caused_by": { "$ref": "#/$defs/id" },
        "actor": { "$ref": "#/$defs/actor" },
        "timestamp": { "type": "string", "format": "date-time" },
        "monotonic_ms": { "type": "integer", "minimum": 0 },
        "type": { "enum": ["model_call.started", "model_call.completed", "tool_call.started", "tool_call.completed", "observation.received", "decision.recorded", "file_change.recorded", "state_change.recorded", "error.recorded", "retry.started", "human_feedback.recorded", "evaluation.completed"] },
        "data": true,
        "prev_sha256": { "$ref": "#/$defs/sha256" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "model_call.started" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/modelStarted" } } }
        },
        {
          "if": { "properties": { "type": { "const": "model_call.completed" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/modelCompleted" } } }
        },
        {
          "if": { "properties": { "type": { "const": "tool_call.started" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/toolStarted" } } }
        },
        {
          "if": { "properties": { "type": { "const": "tool_call.completed" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/toolCompleted" } } }
        },
        {
          "if": { "properties": { "type": { "const": "observation.received" } } },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source"],
                "properties": {
                  "source": { "type": "string", "minLength": 1 },
                  "value": { "$ref": "#/$defs/inlineContent" },
                  "data_ref": { "$ref": "#/$defs/observationRef" }
                },
                "oneOf": [ { "required": ["value"] }, { "required": ["data_ref"] } ]
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "decision.recorded" } } },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["options", "chosen"],
                "properties": {
                  "options": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["summary"],
                      "properties": {
                        "summary": { "type": "string", "minLength": 1 },
                        "tool": { "type": "string" }
                      }
                    }
                  },
                  "chosen": { "type": "integer", "minimum": 0 },
                  "rationale_ref": { "$ref": "#/$defs/modelReasoningRef" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "file_change.recorded" } } },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "pre_sha256", "post_sha256", "diff_ref"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "pre_sha256": { "$ref": "#/$defs/sha256" },
                  "post_sha256": { "$ref": "#/$defs/sha256" },
                  "diff_ref": { "$ref": "#/$defs/diffRef" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "state_change.recorded" } } },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["entity", "pre_sha256", "post_sha256", "delta"],
                "properties": {
                  "entity": { "type": "string", "minLength": 1 },
                  "pre_sha256": { "$ref": "#/$defs/sha256" },
                  "post_sha256": { "$ref": "#/$defs/sha256" },
                  "delta": { "$ref": "#/$defs/inlineContent" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "error.recorded" } } },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["class", "message"],
                "properties": {
                  "class": { "type": "string", "minLength": 1 },
                  "message": { "type": "string" },
                  "detail_ref": { "$ref": "#/$defs/blobRef" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "retry.started" } } },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["retry_of", "strategy"],
                "properties": {
                  "retry_of": { "$ref": "#/$defs/id" },
                  "strategy": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "human_feedback.recorded" } } },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["verdict", "reason"],
                "properties": {
                  "verdict": { "enum": ["approve", "reject", "override", "correct"] },
                  "target_event_id": { "$ref": "#/$defs/id" },
                  "reason": { "type": "string", "minLength": 1 },
                  "content_ref": { "$ref": "#/$defs/blobRef" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "evaluation.completed" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/evaluation" } } }
        }
      ]
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "model_calls", "tool_calls", "errors", "retries", "tokens_in", "tokens_out", "cost_usd", "wall_ms"],
      "properties": {
        "events": { "type": "integer", "minimum": 0 },
        "model_calls": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "tokens_in": { "type": "integer", "minimum": 0 },
        "tokens_out": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "wall_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_sha256", "signature"],
      "properties": {
        "chain_sha256": { "$ref": "#/$defs/sha256" },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key_id", "algorithm", "value"],
          "properties": {
            "key_id": { "$ref": "#/$defs/id" },
            "algorithm": { "const": "ed25519" },
            "value": { "type": "string", "minLength": 88, "maxLength": 88 }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "seq", "run_id", "trace_id", "timestamp", "monotonic_ms", "prev_sha256", "status", "evaluations", "totals", "seal"],
      "properties": {
        "kind": { "const": "outcome" },
        "seq": { "type": "integer", "minimum": 2 },
        "run_id": { "$ref": "#/$defs/id" },
        "trace_id": { "$ref": "#/$defs/id" },
        "timestamp": { "type": "string", "format": "date-time" },
        "monotonic_ms": { "type": "integer", "minimum": 0 },
        "prev_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["success", "partial", "failure", "aborted"] },
        "evaluations": { "type": "array", "items": { "$ref": "#/$defs/evaluation" } },
        "totals": { "$ref": "#/$defs/totals" },
        "seal": { "$ref": "#/$defs/seal" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["success", "partial", "failure"] } } },
          "then": { "properties": { "evaluations": { "minItems": 1 } } }
        }
      ]
    }
  }
}
