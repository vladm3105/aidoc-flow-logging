{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iplanic.ai/schemas/ualf/datasheet/v1/schema.json",
  "title": "UALF machine-readable dataset datasheet",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "dataset_id", "generated_at", "collection", "composition", "transformations", "rights_and_privacy", "quality", "limitations", "maintenance"],
  "properties": {
    "profile": { "const": "ualf-datasheet/v1" },
    "dataset_id": { "type": "string", "minLength": 3 },
    "generated_at": { "type": "string", "format": "date-time" },
    "collection": { "type": "object", "minProperties": 1 },
    "composition": { "type": "object", "minProperties": 1 },
    "transformations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rights_and_privacy": { "type": "object", "minProperties": 1 },
    "quality": { "type": "object", "minProperties": 1 },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "maintenance": { "type": "object", "required": ["contact", "revocation_process"], "properties": { "contact": { "type": "string", "minLength": 1 }, "revocation_process": { "type": "string", "minLength": 1 } } }
  }
}
