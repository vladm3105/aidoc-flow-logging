{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iplanic.ai/schemas/ualf/erasure-statement/v1/schema.json",
  "title": "UALF signed erasure or revocation statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "organization", "project", "environment", "subject", "action", "effective_at", "authority", "propagation", "seal"],
  "properties": {
    "profile": { "const": "ualf-erasure-statement/v1" },
    "organization": { "type": "string", "minLength": 3 },
    "project": { "type": "string", "minLength": 3 },
    "environment": { "type": "string", "minLength": 1 },
    "subject": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256"], "properties": { "kind": { "enum": ["trace", "dataset", "blob", "projection"] }, "id": { "type": "string", "minLength": 3 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "action": { "enum": ["revoke", "delete", "cryptographic_shred", "anonymize"] },
    "effective_at": { "type": "string", "format": "date-time" },
    "authority": { "type": "object", "required": ["id", "role", "registry"], "properties": { "id": { "type": "string", "minLength": 3 }, "role": { "type": "string", "minLength": 1 }, "registry": { "type": "string", "format": "uri" } } },
    "propagation": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["target", "status"], "properties": { "target": { "enum": ["canonical", "catalog", "analytics", "cache", "backup", "export"] }, "status": { "enum": ["pending", "completed", "not_applicable", "blocked"] }, "completed_at": { "type": "string", "format": "date-time" } } } },
    "seal": { "$ref": "#/$defs/seal" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "seal": { "type": "object", "additionalProperties": false, "required": ["key_id", "algorithm", "public_key", "document_sha256", "signature"], "properties": { "key_id": { "type": "string", "minLength": 3 }, "algorithm": { "const": "ed25519" }, "public_key": { "type": "string", "minLength": 44, "maxLength": 44 }, "document_sha256": { "$ref": "#/$defs/sha256" }, "signature": { "type": "string", "minLength": 88, "maxLength": 88 } } }
  }
}
