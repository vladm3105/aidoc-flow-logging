{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iplanic.ai/schemas/ualf/aat-export/draft-00/manifest.schema.json",
  "title": "UALF to AAT draft-00 transformation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "claim", "transformed_at", "source", "source_context", "export", "exporter", "validator", "hashing", "identity", "record_mappings", "omissions", "integrity", "seal"],
  "properties": {
    "schema": { "const": "ualf-aat-export-manifest/v1" },
    "profile": { "const": "draft-sharif-agent-audit-trail-00" },
    "claim": { "enum": ["aat-exported/draft-sharif-agent-audit-trail-00", "aat-validated/draft-sharif-agent-audit-trail-00"] },
    "transformed_at": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/artifact" },
    "source_context": { "$ref": "#/$defs/artifact" },
    "export": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        { "type": "object", "required": ["record_count", "session_ids"], "properties": { "record_count": { "type": "integer", "minimum": 2 }, "session_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid4" } } } }
      ]
    },
    "exporter": { "$ref": "#/$defs/component" },
    "validator": { "$ref": "#/$defs/component" },
    "hashing": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "json", "text", "binary", "content_encoding"],
      "properties": { "algorithm": { "const": "sha256-lowercase-hex" }, "json": { "const": "rfc8785-jcs" }, "text": { "const": "utf8-exact-no-normalization" }, "binary": { "const": "decoded-octets" }, "content_encoding": { "const": "decode-identity-or-gzip-before-hashing" } }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "agent_version", "trust_level", "trust_authority", "trust_basis"],
      "properties": { "agent_id": { "type": "string", "format": "uri" }, "agent_version": { "type": "string" }, "trust_level": { "enum": ["L0", "L1", "L2", "L3", "L4"] }, "trust_authority": { "type": "string", "minLength": 1 }, "trust_basis": { "type": "string", "minLength": 1 }, "signing_key_id": { "type": "string", "minLength": 1 }, "signing_key_binding": { "type": "string", "format": "uri-reference" } }
    },
    "record_mappings": {
      "type": "array", "minItems": 2,
      "items": { "type": "object", "additionalProperties": false, "required": ["record_id", "session_id", "source_records"], "properties": { "record_id": { "$ref": "#/$defs/uuid4" }, "session_id": { "$ref": "#/$defs/uuid4" }, "source_records": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } }
    },
    "omissions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["source_record", "reason"], "properties": { "source_record": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } } } },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["ualf_chain_sha256", "aat_session_hashes"],
      "properties": { "ualf_chain_sha256": { "$ref": "#/$defs/sha256" }, "aat_session_hashes": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/uuid4" }, "additionalProperties": { "$ref": "#/$defs/sha256" } } }
    },
    "seal": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_sha256", "key_id", "algorithm", "public_key", "signature"],
      "properties": { "manifest_sha256": { "$ref": "#/$defs/sha256" }, "key_id": { "type": "string", "minLength": 1 }, "algorithm": { "const": "ed25519" }, "public_key": { "type": "string", "minLength": 43, "maxLength": 44 }, "signature": { "type": "string", "minLength": 86, "maxLength": 88 } }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uuid4": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "safePath": { "type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "artifact": { "type": "object", "required": ["path", "sha256", "bytes"], "properties": { "path": { "$ref": "#/$defs/safePath" }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 1 }, "record_count": { "type": "integer", "minimum": 1 }, "session_ids": { "type": "array", "items": { "$ref": "#/$defs/uuid4" } } } },
    "component": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } }
  }
}
